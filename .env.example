# Vyravid local configuration
VYRAVID_LOCAL=true
VYRAVID_PUBLIC_BASE=http://localhost:8000
JWT_SECRET_KEY=local-dev-secret
CLOUD_VIDEO_PROCESSOR_URL=http://localhost:8000/vp
USE_CLOUD_PROCESSING=true
WEBHOOK_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Local paths are derived by scripts/start-api.sh from the checkout path.
# For a typical clone at ~/vyravid, the active DB will be:
# ~/vyravid/data/db/openvid.sqlite3

# AI provider keys
GOOGLE_API_KEY=
GOOGLE_GEMINI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
REPLICATE_API_KEY=


# Local transcription service
TRANSCRIPTION_SERVICE=faster-whisper
FASTER_WHISPER_MODEL=large-v3
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8
