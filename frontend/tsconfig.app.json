{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "remotion/**/*"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "remotion": ["./node_modules/remotion"],
      "@/*": ["./src/*"]
    },
    "jsx": "react",
    "jsxImportSource": "",
    "types": ["node"]
  }
}
